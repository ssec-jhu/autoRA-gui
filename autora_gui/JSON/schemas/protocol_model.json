{
  "$defs": {
    "Cardinality": {
      "description": "A model for cardinality in the workflow.",
      "properties": {
        "minOccurs": {
          "default": 0,
          "title": "Minoccurs",
          "type": "integer"
        },
        "maxOccurs": {
          "default": 1,
          "title": "Maxoccurs",
          "type": "integer"
        },
        "unique": {
          "default": true,
          "title": "Unique",
          "type": "boolean"
        }
      },
      "title": "Cardinality",
      "type": "object"
    },
    "Datatype": {
      "description": "Datatype model for the workflow.",
      "enum": [
        "real",
        "integer",
        "boolean",
        "string",
        "categorical",
        "any",
        "IV",
        "DV"
      ],
      "title": "Datatype",
      "type": "string"
    },
    "DictVariableType": {
      "description": "A model for dictionary variables in the workflow.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
