              "$ref": "#/$defs/PrimitiveVariableType"
            },
            {
              "$ref": "#/$defs/ListVariableType"
            },
            {
              "$ref": "#/$defs/DictVariableType"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/PrimitiveVariableType"
                  },
                  {
                    "$ref": "#/$defs/ListVariableType"
                  },
                  {
                    "$ref": "#/$defs/DictVariableType"
                  }
                ]
              },
              "type": "array"
            }
          ],
          "title": "Variables"
        }
      },
      "required": [
        "variables"
      ],
      "title": "DictVariableType",
      "type": "object"
    },
    "ListVariableType": {
      "description": "A model for list variables in the workflow.",
