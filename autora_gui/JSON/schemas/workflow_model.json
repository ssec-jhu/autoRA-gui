{
  "$defs": {
    "CanvasLocation": {
      "description": "A class for node's canvas location.\n\nIncludes x and y coordinates.",
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "CanvasLocation",
      "type": "object"
    },
    "Cardinality": {
      "description": "A model for cardinality in the workflow.",
      "properties": {
        "minOccurs": {
          "default": 0,
          "title": "Minoccurs",
          "type": "integer"
        },
        "maxOccurs": {
          "default": 1,
          "title": "Maxoccurs",
          "type": "integer"
        },
        "unique": {
          "default": true,
          "title": "Unique",
          "type": "boolean"
        }
      },
      "title": "Cardinality",
      "type": "object"
    },
    "Datatype": {
      "description": "Datatype model for the workflow.",
      "enum": [
        "real",
        "integer",
        "boolean",
        "string",
        "categorical",
        "any"
      ],
      "title": "Datatype",
      "type": "string"
    },
    "DictVariableType": {
      "description": "A model for dictionary variables in the workflow.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "variables": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/PrimitiveVariableType"
              },
              {
                "$ref": "#/$defs/ListVariableType"
              },
              {
                "$ref": "#/$defs/DictVariableType"
              }
            ]
          },
          "title": "Variables",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "variables"
      ],
      "title": "DictVariableType",
      "type": "object"
    },
    "EndComponent": {
      "description": "An end component model for AutoRA GUI.\n\nServes as the ending point of the workflow.",
      "properties": {
        "uuid": {
          "format": "uuid",
          "title": "Uuid",
          "type": "string"
        },
        "canvasLocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanvasLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "uuid",
        "canvasLocation"
      ],
      "title": "EndComponent",
      "type": "object"
    },
    "FilterComponent": {
      "description": "A filter component model for AutoRA GUI.\n\nServes as a decision/filter point in the workflow.",
      "properties": {
        "uuid": {
          "format": "uuid",
          "title": "Uuid",
          "type": "string"
        },
        "canvasLocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanvasLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxCounter": {
          "default": 1,
          "title": "Maxcounter",
          "type": "integer"
        },
        "altTarget": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alttarget"
        }
      },
      "required": [
        "uuid",
        "canvasLocation"
      ],
      "title": "FilterComponent",
      "type": "object"
    },
    "Link": {
      "description": "A link (connection) model for Autora gui.\n\nIncludes output and input nodes being connected by the given link.",
      "properties": {
        "source": {
          "format": "uuid",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "format": "uuid",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "Link",
      "type": "object"
    },
    "ListVariableType": {
      "description": "A model for list variables in the workflow.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "variable": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrimitiveVariableType"
            },
            {
              "$ref": "#/$defs/ListVariableType"
            },
            {
              "$ref": "#/$defs/DictVariableType"
            }
          ],
          "title": "Variable"
        }
      },
      "required": [
        "name",
        "description",
        "variable"
      ],
      "title": "ListVariableType",
      "type": "object"
    },
    "ParameterSetting": {
      "description": "A class for parameter setting.\n\nIncludes the description.",
      "properties": {
        "uuid": {
          "format": "uuid",
          "title": "Uuid",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "value"
      ],
      "title": "ParameterSetting",
      "type": "object"
    },
    "PrimitiveVariableType": {
      "description": "Primitive variable type model for the workflow.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "datatype": {
          "$ref": "#/$defs/Datatype"
        },
        "cardinality": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cardinality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validValues": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validvalues"
        },
        "default": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "name",
        "description",
        "datatype"
      ],
      "title": "PrimitiveVariableType",
      "type": "object"
    },
    "ProtocolComponent": {
      "description": "A protocol component model for AutoRA GUI.\n\nIncludes node parameters.",
      "properties": {
        "uuid": {
          "format": "uuid",
          "title": "Uuid",
          "type": "string"
        },
        "canvasLocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanvasLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocolUuid": {
          "format": "uuid",
          "title": "Protocoluuid",
          "type": "string"
        },
        "parameterSetting": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ParameterSetting"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parametersetting"
        }
      },
      "required": [
        "uuid",
        "canvasLocation",
        "protocolUuid",
        "parameterSetting"
      ],
      "title": "ProtocolComponent",
      "type": "object"
    },
    "StartComponent": {
      "description": "A start component model for AutoRA GUI.\n\nServes as the starting point of the workflow.",
      "properties": {
        "uuid": {
          "format": "uuid",
          "title": "Uuid",
          "type": "string"
        },
        "canvasLocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanvasLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "uuid",
        "canvasLocation"
      ],
      "title": "StartComponent",
      "type": "object"
    }
  },
  "description": "A workflow model for AutoRA GUI.\n\nIncludes all possible elements like nodes and links.",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "start": {
      "anyOf": [
        {
          "$ref": "#/$defs/StartComponent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "end": {
      "anyOf": [
        {
          "$ref": "#/$defs/EndComponent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "filters": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/FilterComponent"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Filters"
    },
    "independentVariables": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrimitiveVariableType"
        },
        {
          "$ref": "#/$defs/ListVariableType"
        },
        {
          "$ref": "#/$defs/DictVariableType"
        }
      ],
      "title": "Independentvariables"
    },
    "dependentVariables": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrimitiveVariableType"
        },
        {
          "$ref": "#/$defs/ListVariableType"
        },
        {
          "$ref": "#/$defs/DictVariableType"
        }
      ],
      "title": "Dependentvariables"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/ProtocolComponent"
      },
      "title": "Components",
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/Link"
      },
      "title": "Links",
      "type": "array"
    }
  },
  "required": [
    "name",
    "independentVariables",
    "dependentVariables",
    "components",
    "links"
  ],
  "title": "Workflow",
  "type": "object"
}