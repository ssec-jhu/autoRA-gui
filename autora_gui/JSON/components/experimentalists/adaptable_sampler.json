          "unique": false
        },
        "validValues": null,
        "default": null
      },
      {
        "name": "models",
        "description": "list of models",
        "datatype": "string",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": -1,
          "unique": true
        },
        "validValues": null,
        "default": null
      }
    ]
