{
  "uuid": "e8eb1ee0-7bf7-47f1-833a-54b471edd252",
  "protocolType": "experimentalist",
  "name": "Adaptable Sampler",
  "description": "adaptive experimentalist that samples from a set of samplers based on its history of surprisal (as jensen shannon divergence)",
  "githubCommit": "https://github.com/MoAljam/autora-experimentalist-challenge-g-1/blob/4e96fcc4fe8b5ca24a3bd507d566f99199ba9ab9/src/autora/experimentalist/adaptable/__init__.py#L402",
  "github_io": "https://autoresearch.github.io/autora/experimentalist/",
  "pythonName": "sample",
  "importPath": "autora.experimentalist.adaptable",
  "pipInstall": "autora-adaptable-experimentalist",
  "parameters": {
    "sample": [
      {
        "name": "samplers",
        "description": "list of dicts each sampler is a dictionary with the following keys: - func: callable sampler - params: dict - name: str sampler_coords: list of the locations of the samplers on arbitrary 1d-scale",
        "datatype": "real",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": null
      },
      {
        "name": "samplers_coords",
        "description": "",
        "datatype": "real",
        "cardinality": {
          "minOccurs": 0,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": null
      },
      {
        "name": "num_samples",
        "description": "number of samples to generate",
        "datatype": "integer",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": 1
      },
      {
        "name": "meta_score_func",
        "description": "callable, function to calculate the meta score",
        "datatype": "string",
        "cardinality": {
          "minOccurs": 0,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": null
      },
      {
        "name": "sensitivity",
        "description": "float, int, scaler for the exponential bias higher number maps to more sensitivity of changes in the meta score (surprisal , jsd)",
        "datatype": "integer",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": 8
      },
      {
        "name": "temperature",
        "description": "float, int, scaler for the std of the gaussian distribution around the mapping int the sampling space",
        "datatype": "real",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": 0.1
      },
      {
        "name": "plot_info",
        "description": "bool, plot the distributions",
        "datatype": "boolean",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": false
      }
    ]
  },
  "inputDataType": {
    "variables": [
      {
        "name": "conditions",
