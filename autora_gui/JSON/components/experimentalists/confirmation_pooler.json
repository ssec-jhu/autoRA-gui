{
  "uuid": "15530705-aa4e-445a-9c9f-1c51c5b1575b",
  "protocolType": "experimentalist",
  "name": "Confirmation Pooler",
  "description": "A pooler that generates samples for independent variables with the objective of maximizing the (approximated) loss of the model. The samples are generated by first training a neural network to approximate the loss of a model for all patterns in the training data. Once trained, the network is then inverted to generate samples that maximize the approximated loss of the model.",
  "githubCommit": "https://github.com/MoAljam/autora-experimentalist-challenge-g-1/blob/4e96fcc4fe8b5ca24a3bd507d566f99199ba9ab9/src/autora/experimentalist/confirmation/__init__.py#L22",
  "github_io": "https://autoresearch.github.io/autora/experimentalist/",
  "pythonName": "pool",
  "importPath": "autora.experimentalist.confirmation",
  "pipInstall": "autora-adaptable-experimentalist",
  "parameters": {
    "pool": [
      {
        "name": "metadata",
        "description": "Meta-data about the dependent and independent variables",
        "datatype": "string",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": null
      },
      {
        "name": "num_samples",
        "description": "number of samples to return",
        "datatype": "integer",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": 100
      },
      {
        "name": "training_epochs",
        "description": "number of epochs to train the popper network for approximating the error fo the model",
        "datatype": "integer",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": 1000
      },
      {
        "name": "optimization_epochs",
        "description": "number of epochs to optimize the samples based on the trained popper network",
        "datatype": "integer",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": 1000
      },
      {
        "name": "training_lr",
        "description": "learning rate for training the popper network",
        "datatype": "real",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": 0.001
      },
      {
        "name": "optimization_lr",
        "description": "learning rate for optimizing the samples",
        "datatype": "real",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": 0.001
      },
      {
        "name": "limit_offset",
        "description": "a limited offset to prevent the samples from being too close to the value boundaries",
        "datatype": "real",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": 0
      },
      {
        "name": "# 10**-10",
        "description": "",
        "datatype": "string",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": null
      },
      {
        "name": "limit_repulsion",
        "description": "a limited repulsion to prevent the samples from being too close to the allowed value boundaries",
        "datatype": "real",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": 0
      },
      {
        "name": "plot",
        "description": "print out the prediction of the popper network as well as its training loss",
        "datatype": "boolean",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": false
      }
    ]
  },
