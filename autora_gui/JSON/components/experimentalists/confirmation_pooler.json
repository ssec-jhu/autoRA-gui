        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": 1,
          "unique": true
        },
        "validValues": null,
        "default": null
      },
      {
        "name": "reference_conditions",
        "description": "data that the model was trained on",
        "datatype": "real",
        "cardinality": {
          "minOccurs": 1,
          "maxOccurs": -1,
